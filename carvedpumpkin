-- ===== Lights =====
local lightsEnabled = false
local lightConnection = nil

local function cleanLights()
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("PointLight") or v:IsA("SurfaceLight") or v:IsA("SpotLight") then
            v:Destroy()
        end
    end
end

local function startLightCleaner()
    if lightsEnabled then return end
    lightsEnabled = true
    cleanLights()
    lightConnection = Workspace.DescendantAdded:Connect(function(obj)
        if obj:IsA("PointLight") or obj:IsA("SurfaceLight") or obj:IsA("SpotLight") then
            obj:Destroy()
            return
        end
        for _, v in ipairs(obj:GetDescendants()) do
            if v:IsA("PointLight") or v:IsA("SurfaceLight") or v:IsA("SpotLight") then
                v:Destroy()
            end
        end
    end)
    task.spawn(function()
        while lightsEnabled do
            cleanLights()
            task.wait(0.5)
        end
    end)
end

local function stopLightCleaner()
    lightsEnabled = false
    if lightConnection then
        lightConnection:Disconnect()
        lightConnection = nil
    end
end

-- ===== Pumpkin detection =====
local function getPumpkinType(model)
    for _, desc in ipairs(model:GetDescendants()) do
        if desc:IsA("SpecialMesh") or desc:IsA("MeshPart") then
            if desc.MeshId == CARVED_MESH then
                return "Carved"
            elseif desc.MeshId == ORDINARY_MESH then
                return "Ordinary"
            end
        end
    end
    if model.Name == "Pumpkin" then
        return "Ordinary"
    end
    return nil
end

local function getOwner(model)
    local owner = model:FindFirstChild("Owner")
    if owner then
        if owner:IsA("StringValue") or owner:IsA("ObjectValue") then
            return tostring(owner.Value)
        end
        return owner.Name
    end
    return "Unknown"
end

local function getPumpkins()
    local pumpkins = {}
    local playerModels = Workspace:FindFirstChild("PlayerModels")
    if not playerModels then return pumpkins end

    for _, model in ipairs(playerModels:GetChildren()) do
        if model:IsA("Model") then
            local pType = getPumpkinType(model)
            if pType and (currentMode == "All" or currentMode == pType) then
                local size = model:GetExtentsSize()
                table.insert(pumpkins, {
                    Model = model,
                    Height = size.Y,
                    Position = model:GetPivot().Position,
                    Type = pType,
                    Owner = getOwner(model)
                })
            end
        end
    end
    return pumpkins
end

