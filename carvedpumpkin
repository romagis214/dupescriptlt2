function refreshUI()
    for _, child in ipairs(content:GetChildren()) do
        if not child:IsA("UIListLayout") then
            child:Destroy()
        end
    end

    local pumpkins = getPumpkins()

    table.sort(pumpkins, function(a, b) return a.Height > b.Height end)
    local biggest = {}
    for i = 1, math.min(5, #pumpkins) do
        table.insert(biggest, pumpkins[i])
    end

    table.sort(pumpkins, function(a, b) return a.Height < b.Height end)
    local smallest = {}
    for i = 1, math.min(5, #pumpkins) do
        table.insert(smallest, pumpkins[i])
    end

    createSection(content, "Top 5 Biggest", Color3.fromRGB(255, 140, 60), biggest)
    createSection(content, "Top 5 Smallest", Color3.fromRGB(100, 180, 255), smallest)

    print("Refreshed | Mode:", currentMode, "| Found:", #pumpkins)
end

