            rank.Parent = btn

            local heightLabel = Instance.new("TextLabel")
            heightLabel.Size = UDim2.new(1, -40, 1, 0)
            heightLabel.Position = UDim2.new(0, 32, 0, 0)
            heightLabel.BackgroundTransparency = 1
            heightLabel.Text = string.format("%.2f стадов", pumpkin.Height)
            heightLabel.TextColor3 = Color3.fromRGB(230, 230, 240)
            heightLabel.Font = Enum.Font.Gotham
            heightLabel.TextSize = 13
            heightLabel.TextXAlignment = Enum.TextXAlignment.Left
            heightLabel.Parent = btn

            btn.MouseEnter:Connect(function()
                TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(50, 50, 62)}):Play()
            end)
            btn.MouseLeave:Connect(function()
                TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(36, 36, 44)}):Play()
            end)

            btn.MouseButton1Click:Connect(function()
                if hrp and hrp.Parent then
                    hrp.CFrame = CFrame.new(pumpkin.Position + Vector3.new(0, pumpkin.Height/2 + 5, 0))
                end
            end)
        end
    end
end

local function refreshUI()
    for _, child in ipairs(content:GetChildren()) do
        if not child:IsA("UIListLayout") then
            child:Destroy()
        end
    end

    local pumpkins = getPumpkins()

    table.sort(pumpkins, function(a, b) return a.Height > b.Height end)
    local biggest = {}
    for i = 1, math.min(5, #pumpkins) do
        table.insert(biggest, pumpkins[i])
    end

    table.sort(pumpkins, function(a, b) return a.Height < b.Height end)
    local smallest = {}
    for i = 1, math.min(5, #pumpkins) do
        table.insert(smallest, pumpkins[i])
    end

    createSection(content, "🔥  Топ-5 самых больших", Color3.fromRGB(255, 140, 60), biggest)
    createSection(content, "❄️  Топ-5 самых маленьких", Color3.fromRGB(100, 180, 255), smallest)

    print("Обновлено | Найдено тыкв:", #pumpkins)
end

