local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")

local playerModels = workspace:FindFirstChild("PlayerModels")
if not playerModels then
    warn("PlayerModels не найден!")
    return
end

local TARGET_MESH_ID = "rbxassetid://131264540080104"

local function isPumpkin(model)
    for _, descendant in ipairs(model:GetDescendants()) do
        if (descendant:IsA("SpecialMesh") or descendant:IsA("MeshPart")) and descendant.MeshId == TARGET_MESH_ID then
            return true
        end
    end
    return false
end

local biggestSize = -math.huge
local smallestSize = math.huge
local biggestModel, smallestModel = nil, nil
local biggestPos, smallestPos = nil, nil

for _, model in ipairs(playerModels:GetChildren()) do
    if model:IsA("Model") and isPumpkin(model) then
        local size = model:GetExtentsSize()
        local height = size.Y
        
        if height > biggestSize then
            biggestSize = height
            biggestModel = model
            biggestPos = model:GetPivot().Position
        end
        
        if height < smallestSize then
            smallestSize = height
            smallestModel = model
            smallestPos = model:GetPivot().Position
        end
    end
end

if not biggestModel then
    warn("Тыквы не найдены!")
    return
end

print("Большая:", string.format("%.2f", biggestSize), "стадов")
print("Маленькая:", string.format("%.2f", smallestSize), "стадов")

